        }
      ]
    },
    {
      "start": 4.783,
      "end": 6.364,
      "text": "\"Da bist du ja.",
      "words": [
        {
          "word": "\"Da",
          "start": 4.783,
          "end": 4.983,
          "score": 0.73
        },
        {
