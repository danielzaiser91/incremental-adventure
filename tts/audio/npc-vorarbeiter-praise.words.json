          "score": 0.746
        },
        {
          "word": "Glas.",
          "start": 8.665,
          "end": 10.106,
          "score": 0.833
        }
      ]
    },
    {
      "start": 10.126,
      "end": 13.548,
      "text": "\"Du schuftest ordentlich, ohne zu meckern.",
