        {
          "word": "\"Du",
          "start": 10.126,
          "end": 10.306,
          "score": 0.757
        },
        {
          "word": "schuftest",
          "start": 10.346,
          "end": 10.946,
          "score": 0.841
        },
        {
          "word": "ordentlich,",
          "start": 10.986,
          "end": 11.927,
          "score": 0.9
        },
        {
          "word": "ohne",
          "start": 11.967,
          "end": 12.267,
          "score": 0.836
        },
        {
          "word": "zu",
          "start": 12.287,
          "end": 12.427,
          "score": 0.99
        },
        {
          "word": "meckern.",
          "start": 12.487,
          "end": 13.548,
          "score": 0.942
        }
      ]
    },
    {
      "start": 13.588,
      "end": 15.749,
      "text": "Das sieht man nicht oft.\"",
