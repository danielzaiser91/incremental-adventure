          "score": 0.665
        },
        {
          "word": "ja.",
          "start": 5.363,
          "end": 6.364,
          "score": 0.858
        }
      ]
    },
    {
      "start": 6.404,
      "end": 7.945,
      "text": "Setz dich.\"",
