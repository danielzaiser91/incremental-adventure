.claude/settings.local.json
*.code-workspace
prompt-history/

# Node / Playwright (lokale Testumgebung, nicht Teil des Spiels)
node_modules/
package.json
package-lock.json
.package-lock.json
test/screenshots/
test/walkthrough_k*.md
.env.local

# TTS-Pipeline: tts/audio/ ist der EINZIGE veröffentlichte Ort und liegt im
# Repo — dort stehen Opus-Datei und Wort-Zeitstempel jeder fertigen Einheit,
# beides braucht das Spiel im Betrieb. Alles hier drunter sind reine
# Arbeitsverzeichnisse: output/ enthält die WAV-Rohaufnahmen (publish-audio.js
# verschiebt das fertige Opus samt Timings nach audio/), align/ die Ein- und
# Ausgabe des Forced-Alignment. Nichts davon gehört ins Repo, sonst liegt
# dieselbe Vertonung zweimal darin.
tts/output/
tts/align/*.txt
tts/align/*.words.json

# TTS-Forced-Alignment: lokale Python-venv + Modell-Cache (nicht Teil des Repos)
tts/align/.venv/
tts/align/*.log
tts/align/__pycache__/
